# =============================================================================
# Rebuilt Web Cloner — Environment Variables
# =============================================================================

# Server Port (default: 3000)
PORT=3000

# Optional AES-256 Master Key override for Session Vault
# SESSION_VAULT_KEY=your-32-byte-hex-secret-key

# =============================================================================
# Supabase Admin Connection (Strict Admin-Only Access)
# Find in: Supabase Dashboard -> Project Settings -> API
# Note: Use the secret service_role key to bypass RLS as Admin.
# Anon key has 0 access (RLS blocks all public read/write).
# =============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
